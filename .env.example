# ─────────────────────────────────────────────────────────────
#  Nexora · Variables de entorno
#  Copiar a `.env` y ajustar. NUNCA versionar el archivo `.env`.
# ─────────────────────────────────────────────────────────────

# ── Puertos publicados en el host ────────────────────────────
# Ajustables para convivir con otros proyectos en la misma máquina.
PORT_HTTP=8088          # nginx → aplicación completa
PORT_FRONTEND=5183      # Vite dev server (acceso directo)
PORT_BACKEND=8010       # Django HTTP (acceso directo)
PORT_WEBSOCKET=8011     # Daphne (acceso directo)
PORT_POSTGRES=5442
PORT_REDIS=6389
PORT_FLOWER=5599
PORT_MAILHOG=8026
PORT_SMTP=1026

# ── Django ───────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=django-insecure-cambiar-esta-clave-en-produccion-por-favor
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend,websocket,nginx
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5183,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8088,http://localhost:5183
FRONTEND_URL=http://localhost:8088

# ── PostgreSQL 17 ────────────────────────────────────────────
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis / Celery / Channels ────────────────────────────────
REDIS_URL=redis://redis:6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CHANNEL_LAYERS_URL=redis://redis:6379/2
CACHE_URL=redis://redis:6379/3

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_LIFETIME_MINUTES=30
JWT_REFRESH_LIFETIME_DAYS=7

# ── Groq · ÚNICO proveedor externo de IA ─────────────────────
# Resuelve LLM (chat, análisis, exámenes) y Speech-to-Text (Whisper).
#
# La clave se lee SOLO de esta variable de entorno. Nunca la escribas en el
# código, en un Dockerfile ni en un archivo versionado.
# Consíguela en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Modelos en https://console.groq.com/docs/models
#   llama-3.3-70b-versatile   equilibrio calidad/velocidad (recomendado)
#   llama-3.1-8b-instant      el más rápido, JSON estructurado menos fiable
#   openai/gpt-oss-120b       mejor razonamiento, más lento y con cuota menor
#
# Nota medida contra la API (agosto 2026): ninguno de los modelos de chat del
# nivel gratuito admite `response_format: json_schema` (Structured Outputs
# estricto). El adaptador lo intenta, recibe 400 una vez por proceso y degrada a
# modo JSON + validación Pydantic con reintento correctivo, que es el camino
# real en producción. Si un modelo gana soporte, se activa solo.
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=120

# Transcripción de audio/video. `whisper-large-v3` conserva timestamps por
# segmento; `whisper-large-v3-turbo` es más rápido y algo menos preciso.
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_TRANSCRIBE_TIMEOUT=600

# ── Embeddings LOCALES (SentenceTransformers) ────────────────
# Se calculan dentro del worker: ninguna llamada externa.
#
# E5 es multilingüe (384 dims) y está entrenado para búsqueda ASIMÉTRICA
# (pregunta corta contra pasaje largo), que es lo que hace el RAG.
#
# E5 exige prefijar el texto ("query: " / "passage: "). Los prefijos viven en
# `EMBEDDING_SETTINGS` (config/settings/base.py) y no aquí a propósito: llevan
# un espacio final significativo que un archivo .env no transporta de forma
# fiable. Con un modelo que no los necesite, defínelos vacíos allí.
#
# Cambiar de modelo cambia la dimensión del vector Y la escala de los umbrales
# del recuperador (ver más abajo). Después de cambiarlo:
#     docker compose exec celery-ai python manage.py rebuild_indices
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ── Ajustes de las cadenas de análisis ───────────────────────
# Tamaño máximo del texto que se envía a las cadenas de análisis.
# 8000 encaja en el límite gratuito de Groq (12.000 tokens por minuto, contando
# prompt + salida reservada). Con un plan de pago puedes subirlo bastante.
AI_ANALYSIS_MAX_CHARS=8000

# Por debajo de esta longitud el análisis usa UNA sola llamada al LLM en vez de
# cuatro (capítulos, resumen, conceptos y FAQ). Para documentos cortos divide el
# tiempo de procesamiento por cerca de cuatro.
AI_COMPACT_ANALYSIS_CHARS=5000

# Preguntas por llamada al generar un examen. 3 encaja en la cuota gratuita.
AI_EXAM_BATCH_SIZE=3

# ── RAG ──────────────────────────────────────────────────────
FAISS_INDEX_ROOT=/app/indices
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=8

# Umbrales por debajo de los cuales la IA responde "no encontré esa información
# en el material" en vez de improvisar. **Van atados al modelo de embeddings**:
# la escala de similitud no es comparable entre modelos. Estos valores están
# medidos para `multilingual-e5-small` sobre material de capacitación
# (fragmentos relevantes ~0,88; consultas ajenas ~0,70-0,81).
# Si cambias EMBEDDING_MODEL, recalíbralos:
#     docker compose exec backend python manage.py rag_eval --training <uuid>
RETRIEVER_MIN_SCORE=0.78
RETRIEVER_MIN_TOP_SCORE=0.82
HYBRID_SEARCH_ENABLED=1
LLM_TEMPERATURE=0.1
# Groq descuenta este máximo del cupo por minuto aunque no se llegue a usar,
# así que subirlo "por si acaso" provoca 429 en el nivel gratuito.
LLM_MAX_TOKENS=2048

# ── Almacenamiento y límites ─────────────────────────────────
STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
MAX_VIDEO_SIZE_MB=4096
MAX_DOCUMENT_SIZE_MB=100
UPLOAD_CHUNK_SIZE_MB=5

# ── Correo ───────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=no-reply@nexora.local

# ── Frontend (Vite) ──────────────────────────────────────────
# Apuntan al reverse proxy: una sola URL para API, WebSocket y media.
VITE_API_URL=http://localhost:8088/api/v1
VITE_WS_URL=ws://localhost:8088/ws

# ── Observabilidad (opcional) ────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
