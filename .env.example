# ─────────────────────────────────────────────────────────────
#  Capacita IA · Variables de entorno
#  Copiar a `.env` y ajustar. NUNCA versionar el archivo `.env`.
# ─────────────────────────────────────────────────────────────

# ── Puertos publicados en el host ────────────────────────────
# Ajustables para convivir con otros proyectos en la misma máquina.
PORT_HTTP=8088          # nginx → aplicación completa
PORT_FRONTEND=5183      # Vite dev server (acceso directo)
PORT_BACKEND=8010       # Django HTTP (acceso directo)
PORT_WEBSOCKET=8011     # Daphne (acceso directo)
PORT_POSTGRES=5442
PORT_REDIS=6389
PORT_OLLAMA=11435
PORT_FLOWER=5599
PORT_MAILHOG=8026
PORT_SMTP=1026

# ── Django ───────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=django-insecure-cambiar-esta-clave-en-produccion-por-favor
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend,websocket,nginx
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5183,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8088,http://localhost:5183
FRONTEND_URL=http://localhost:8088

# ── PostgreSQL 17 ────────────────────────────────────────────
POSTGRES_DB=capacita
POSTGRES_USER=capacita
POSTGRES_PASSWORD=capacita
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis / Celery / Channels ────────────────────────────────
REDIS_URL=redis://redis:6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CHANNEL_LAYERS_URL=redis://redis:6379/2
CACHE_URL=redis://redis:6379/3

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_LIFETIME_MINUTES=30
JWT_REFRESH_LIFETIME_DAYS=7

# ── Proveedor de IA (GRATIS por defecto: Ollama local) ───────
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434

# Modelo por defecto pensado para CPU (sin GPU). Elige según tu hardware:
#   qwen2.5:1.5b-instruct   ~1 GB   CPU        rápido, suficiente para JSON y RAG
#   llama3.2:3b-instruct    ~2 GB   CPU 8+ núcleos
#   qwen2.5:7b-instruct     ~4.7 GB GPU (o CPU con mucha paciencia) mejor calidad
OLLAMA_LLM_MODEL=qwen2.5:1.5b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Los modelos locales en CPU pueden tardar minutos por llamada.
OLLAMA_TIMEOUT=900

# Techo de la ventana de contexto. El valor real se calcula por llamada según el
# tamaño del prompt: en CPU una ventana grande cuesta caro aunque no se llene
# (medido: 8192 frente a 2048 puede ser 2-4 veces más lento con el mismo texto).
OLLAMA_MAX_CTX=8192

# Tamaño máximo del texto que se envía a las cadenas de análisis.
# Bájalo si el modelo es pequeño o el equipo es lento; súbelo con GPU.
AI_ANALYSIS_MAX_CHARS=6000

# Por debajo de esta longitud el análisis usa UNA sola llamada al LLM en vez de
# cuatro (capítulos, resumen, conceptos y FAQ). Para documentos cortos divide el
# tiempo de procesamiento por cerca de cuatro.
AI_COMPACT_ANALYSIS_CHARS=5000

# Preguntas por llamada al generar un examen. Con modelos pequeños, 2 es lo que
# completa de forma fiable; con GPU puedes subirlo a 5 o más.
AI_EXAM_BATCH_SIZE=2

# Alternativa de pago (opcional, solo si AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Transcripción (GRATIS, local) ────────────────────────────
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5

# ── RAG ──────────────────────────────────────────────────────
FAISS_INDEX_ROOT=/app/indices
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
RETRIEVER_TOP_K=8
RETRIEVER_MIN_SCORE=0.35
RETRIEVER_MIN_TOP_SCORE=0.45
HYBRID_SEARCH_ENABLED=1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ── Almacenamiento y límites ─────────────────────────────────
STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
MAX_VIDEO_SIZE_MB=4096
MAX_DOCUMENT_SIZE_MB=100
UPLOAD_CHUNK_SIZE_MB=5

# ── Correo ───────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=no-reply@capacita.local

# ── Frontend (Vite) ──────────────────────────────────────────
# Apuntan al reverse proxy: una sola URL para API, WebSocket y media.
VITE_API_URL=http://localhost:8088/api/v1
VITE_WS_URL=ws://localhost:8088/ws

# ── Observabilidad (opcional) ────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
